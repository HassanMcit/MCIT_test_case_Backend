# Isolated Staging NestJS Backend Environment Template
# DO NOT commit real passwords, connection strings, or JWT secrets.
# Configure these variables in the Render Dashboard for the NEW staging service:
#   Service Name: mcit-test-case-backend-staging

NODE_ENV=production
MCIT_DEPLOYMENT_ENV=staging
PORT=3001

# Neon Staging PostgreSQL Direct Connection String (SSL required, non-pooled)
DATABASE_URL=postgresql://neondb_owner:<REDACTED_NEON_PASSWORD>@<STAGING_NEON_HOST>/neondb?sslmode=require&channel_binding=require

# Staging-only JWT signing secret (generate via: openssl rand -base64 32)
# NEVER reuse the production Render JWT_SECRET.
JWT_SECRET=<GENERATE_NEW_STAGING_ONLY_RANDOM_SECRET>
JWT_EXPIRES_IN=7d

# Database safety guards: disable all automatic bootstrap, DDL, and background deadline scans on startup
ALLOW_DATABASE_BOOTSTRAP=false
ENABLE_PROJECT_DEADLINE_WORKER=false

# Exact comma-separated HTTPS origins allowed by CORS (no trailing slash, no wildcards)
CORS_ALLOWED_ORIGINS=https://mcit-test-case-front-staging.hassan-a173784.workers.dev,https://mcit-test-case-backend-staging.onrender.com

# Public HTTPS origin of the staging Render backend (used for user photo URL resolution)
BACKEND_URL=https://mcit-test-case-backend-staging.onrender.com
